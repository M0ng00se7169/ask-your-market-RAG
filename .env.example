# Ask Your Market — environment template
# Copy to .env and fill in the values.

# LLM via OpenRouter (OpenAI-compatible). Must support tool calling.
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Local embedding model for semantic search over product descriptions.
# Options tested: intfloat/multilingual-e5-small, BAAI/bge-m3
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Paths (relative to repo root)
SNAPSHOTS_CSV=data/snapshots.csv
Chroma_DIR=chroma_db

# Optional: how many results semantic search returns by default
DEFAULT_TOP_K=8
